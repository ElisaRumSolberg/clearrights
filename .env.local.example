# Option A: Vertex AI with your Google Cloud login
#   run once: gcloud auth application-default login
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global

# Option B: AI Studio API key (https://aistudio.google.com/apikey)
# If set, this is used instead of Vertex AI.
GEMINI_API_KEY=

# Optional. Defaults: gemini-3-flash-preview (Vertex), gemini-2.5-flash (API key)
GEMINI_MODEL=
